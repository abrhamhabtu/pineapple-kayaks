# Cloudflare Pages _headers
# Security and caching headers for Pineapple Kayaks Kauaʻi

# HTML pages: must-revalidate, security headers
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Root index (when served as /)
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images: long cache with immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Videos: long cache with immutable
/img/video/*
  Cache-Control: public, max-age=31536000, immutable

# CSS: must-revalidate (query string ?v= handles versioning)
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# JS: must-revalidate (query string ?v= handles versioning)
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Fonts (if any are hosted locally): long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
